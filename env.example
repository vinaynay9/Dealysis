# Dealysis Environment Configuration
# Copy this file to .env in apps/web/ and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string (recommended: Neon serverless)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/dealysis

# =============================================================================
# AUTHENTICATION (Auth.js)
# =============================================================================
# Secret key for session encryption - generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secret-key-change-this-in-production

# =============================================================================
# AI INTEGRATION
# =============================================================================
# Note: This app uses an internal ChatGPT integration endpoint
# The endpoint is: /integrations/chat-gpt/conversationgpt4
# Ensure your hosting environment provides this integration

# =============================================================================
# FILE STORAGE (Optional)
# =============================================================================
# Uploadcare for media uploads (charts, images, documents)
# Get keys from: https://uploadcare.com/
UPLOADCARE_PUBLIC_KEY=demopublickey
UPLOADCARE_SECRET_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Base URL for the application (used for callbacks, emails, etc.)
BASE_URL=http://localhost:5173

# Node environment
NODE_ENV=development

# =============================================================================
# OPTIONAL: MONITORING & ANALYTICS
# =============================================================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# Analytics API key (optional)
# ANALYTICS_API_KEY=

# =============================================================================
# OPTIONAL: EMAIL (for password reset, notifications)
# =============================================================================
# SMTP settings if email features are enabled
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# =============================================================================
# LIMITS & CONFIGURATION
# =============================================================================
# Maximum file upload size in MB (default: 50)
MAX_FILE_SIZE_MB=50

# Maximum text analysis length in characters (default: 25000)
MAX_ANALYSIS_LENGTH=25000

# Maximum context length for memo generation (default: 20000)
MAX_CONTEXT_LENGTH=20000

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

