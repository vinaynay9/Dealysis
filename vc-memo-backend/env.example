# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Configuration (optional, for Plan C)
CLAUDE_API_KEY=your_claude_api_key_here

# Ollama Configuration (optional, for local LLM)
# Install Ollama from https://ollama.ai and run: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=true

# Ollama Auto-Setup (for testing/development)
# Set OLLAMA_AUTO_SETUP=true to automatically configure Ollama on backend startup
# Set OLLAMA_AUTO_INSTALL=true to also install Ollama via Homebrew if not found (requires Homebrew)
OLLAMA_AUTO_SETUP=false
OLLAMA_AUTO_INSTALL=false

# Server Configuration (optional, defaults to 8000)
PORT=8000

# Environment
ENVIRONMENT=production

